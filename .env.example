# ==============================================================================
# FakeNewsBlockchain - Environment Configuration Template
# Copy this file to .env and populate local values. NEVER commit .env to Git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# CPU Resource Limits (tuned for 16 GB RAM CPU-only local inference)
TORCH_NUM_THREADS=4

# Machine Learning Models (relative to project root; excluded from Git)
MODEL_FEVER_PATH=Requirements/fever_verifier_v1
MODEL_ISOT_PATH=Requirements/bert_isot_temporal_v1
MODEL_LIAR_PATH=Requirements/bert_liar_v1/final_model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Retrieval & Knowledge Base (FAISS + Normalized FEVER Corpus)
RETRIEVAL_INDEX_PATH=Requirements/wiki_fever.index
RETRIEVAL_ROW_MAPPING_PATH=Requirements/row_mapping.jsonl
RETRIEVAL_SENTENCES_PATH=Requirements/sentences.jsonl
MAX_EVIDENCE_RETRIEVAL_K=5

# Database & File Uploads
DATABASE_URL=sqlite+aiosqlite:///data/database/fakenews.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=10

# Blockchain Configuration (Ethereum Sepolia Testnet / Hardhat Local)
# Set BLOCKCHAIN_ENABLED=True to enable read-only queries and optional anchoring.
BLOCKCHAIN_ENABLED=True
# Sepolia JSON-RPC URL (e.g., https://ethereum-sepolia-rpc.publicnode.com or Infura/Alchemy URL)
SEPOLIA_RPC_URL=
# Wallet private key for Sepolia testnet test ETH ONLY (never commit real keys)
SEPOLIA_PRIVATE_KEY=
# Sepolia Expected Chain ID
SEPOLIA_CHAIN_ID=11155111
# Deployed VerificationRegistry contract address (0x...)
CONTRACT_ADDRESS=

# Optional External Evidence & Public Fallback APIs (Zero Paid Tiers)
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_FACT_CHECK_TIMEOUT_SEC=8.0
NEWS_API_KEY=
WIKIPEDIA_FALLBACK_ENABLED=true
WIKIPEDIA_TIMEOUT_SEC=8.0

# GDELT DOC 2.0 Shared Request Budget (Conservative quota protection)
GDELT_ENABLED=true
GDELT_REQUEST_LIMIT=200
GDELT_WARNING_THRESHOLD=20
GDELT_CONNECT_TIMEOUT_SEC=8.0
GDELT_TIMEOUT_SEC=12.0
GDELT_MAX_RETRIES=0
GDELT_DEFAULT_TIMESPAN=1month
GDELT_MAX_RECORDS=10
EXTERNAL_CACHE_TTL_HOURS=24

# Public Certificate Verification URL (printed inside PDF QR codes)
# DEVELOPMENT: Use LAN IP or localhost (e.g., http://localhost:5173/verify-certificate)
# PRODUCTION:  Must use a publicly accessible HTTPS URL
PUBLIC_VERIFICATION_BASE_URL=
